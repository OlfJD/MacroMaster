<Window x:Class="MacroMaster.UI.Windows.HudOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Title="MacroMaster HUD"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource RaisedBrush}"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Solid (non-transparent) window on purpose: transparent WPF windows can't use ClearType,
         which is what made the old popups look fuzzy. Fading and click-through are done with
         Win32 window styles in code instead. Corners and the 1px frame come from DWM. -->
    <Grid Margin="12,10,20,10" MinWidth="200" MaxWidth="420">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Either the app logo, or a status icon on a tinted tile -->
        <Image x:Name="HudLogo" Source="{StaticResource LogoMark}" Width="24" Height="24" Margin="2,0,14,0"
               VerticalAlignment="Center" Visibility="Collapsed"/>
        <Border x:Name="IconBadge" Width="28" Height="28" CornerRadius="7" Margin="0,0,12,0" VerticalAlignment="Center">
            <controls:AppIcon x:Name="HudIcon" IconKey="play" Size="16"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="HudTitle" Text="Title" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HudSubtitle" Text="Subtitle" FontSize="12" Margin="0,1,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</Window>
