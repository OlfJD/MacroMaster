<Window x:Class="MacroMaster.UI.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Style="{StaticResource AppWindow}"
        Title="Settings - MacroMaster"
        Icon="/Assets/app.ico"
        Width="640" Height="720"
        MinWidth="560" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One settings row: text on the left, control on the right -->
        <Style x:Key="RowTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="CaptureButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="28,0,10,0">
            <TextBlock Text="Settings" Style="{StaticResource H2}" FontSize="18" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseBtn_Click" ToolTip="Close">
                <controls:AppIcon IconKey="x" Size="16"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,22,24">
            <StackPanel Margin="0,0,6,0">

                <!-- SAFETY -->
                <TextBlock Text="SAFETY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource DangerSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <controls:AppIcon IconKey="octagon-x" Size="16" Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Kill switch" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Stops every macro and releases all held keys and buttons." Style="{StaticResource RowDesc}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtKillswitch" Style="{StaticResource HotkeyBox}" Text="F12"/>
                            <Button x:Name="BtnCaptureKillswitch" Style="{StaticResource CaptureButton}" Content="Capture" Click="BtnCaptureKillswitch_Click" ToolTip="Click, then press a key"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OVERLAY -->
                <TextBlock Text="ON-SCREEN OVERLAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Show notifications" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A small banner when a macro starts, stops or a mode is armed." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkShowOverlay" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbHudPosition" Grid.Column="1" Width="208">
                                <ComboBoxItem Content="Top center"/>
                                <ComboBoxItem Content="Top right (default)"/>
                                <ComboBoxItem Content="Bottom right"/>
                                <ComboBoxItem Content="Bottom center"/>
                                <ComboBoxItem Content="Top left"/>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duration" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHudDuration" Grid.Column="1" Style="{StaticResource HotkeyBox}" Text="2200"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Width="90"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SYSTEM -->
                <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Launches quietly in the tray when you sign in." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Minimize to tray" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="The minimize button hides the window instead of using the taskbar." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Keep running when closed" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Closing the window keeps hotkeys active from the tray." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCloseToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" Click="CloseBtn_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" MinWidth="84" Click="SaveBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
