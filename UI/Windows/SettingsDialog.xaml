<Window x:Class="MacroMaster.UI.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Title="Settings - MacroMaster"
        Icon="/Assets/app.ico"
        Width="620" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1.5" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon IconKey="settings" Foreground="{StaticResource NeonEmeraldGlowBrush}" Size="20" StrokeThickness="2.8" Margin="0,0,10,0"/>
                        <TextBlock Text="Settings &amp; Hotkeys" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Click="CloseBtn_Click">
                        <controls:LucideIcon IconKey="x" Foreground="{StaticResource TextSecondaryBrush}" Size="18" StrokeThickness="2.6"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,14,18,10">
                <StackPanel>
                    <!-- Hotkeys & Emergency Killswitch Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS &amp; SAFETY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <!-- Emergency Killswitch -->
                            <TextBlock Text="Emergency Killswitch (Halts all macros and releases inputs)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtKillswitch" Style="{StaticResource ModernTextBox}" Text="F12" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCaptureKillswitch" Grid.Column="1" Style="{StaticResource GlowButton}" Padding="14,6" Content="Capture" Click="BtnCaptureKillswitch_Click" ToolTip="Click then press any key on your keyboard"/>
                            </Grid>

                            <!-- Hold Left Click Quick Action -->
                            <CheckBox x:Name="ChkHoldLeftClick" Style="{StaticResource ModernSwitch}" Content="Hold Left Click Hotkey" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtHoldLeftClick" Style="{StaticResource ModernTextBox}" Text="PgDn" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCaptureHoldLeftClick" Grid.Column="1" Style="{StaticResource GlowButton}" Padding="14,6" Content="Capture" Click="BtnCaptureHoldLeftClick_Click" ToolTip="Click then press any key or mouse button"/>
                            </Grid>

                            <!-- Auto Clicker Quick Action -->
                            <CheckBox x:Name="ChkAutoClicker" Style="{StaticResource ModernSwitch}" Content="Auto Clicker Hotkey" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAutoClicker" Style="{StaticResource ModernTextBox}" Text="F6" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCaptureAutoClicker" Grid.Column="1" Style="{StaticResource GlowButton}" Padding="14,6" Content="Capture" Click="BtnCaptureAutoClicker_Click" ToolTip="Click then press any key or mouse button"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="CPS (Clicks per Second)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAutoClickerCps" Style="{StaticResource ModernTextBox}" Text="15"/>
                                </StackPanel>
                            </Grid>

                            <!-- Minecraft Mining Loop Quick Action -->
                            <CheckBox x:Name="ChkMinecraftLoop" Style="{StaticResource ModernSwitch}" Content="Minecraft Mining Loop Hotkey" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtMinecraftLoop" Style="{StaticResource ModernTextBox}" Text="F7" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCaptureMinecraftLoop" Grid.Column="1" Style="{StaticResource GlowButton}" Padding="14,6" Content="Capture" Click="BtnCaptureMinecraftLoop_Click" ToolTip="Click then press any key or mouse button"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- HUD / OSD Overlay Settings Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HUD / OSD OVERLAY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkShowOverlay" Style="{StaticResource ModernSwitch}" Content="Enable Floating Neon HUD Banner" IsChecked="True" Margin="0,0,0,12"/>

                            <TextBlock Text="Overlay Screen Position" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbHudPosition" Height="38" Margin="0,0,0,12">
                                <ComboBoxItem Content="Top Center (Recommended)"/>
                                <ComboBoxItem Content="Top Right"/>
                                <ComboBoxItem Content="Bottom Right"/>
                                <ComboBoxItem Content="Bottom Center"/>
                                <ComboBoxItem Content="Top Left"/>
                            </ComboBox>

                            <TextBlock Text="Banner Duration (ms)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtHudDuration" Style="{StaticResource ModernTextBox}" Text="2200"/>
                        </StackPanel>
                    </Border>

                    <!-- System & Safety Settings Card -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SYSTEM &amp; STARTUP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource ModernSwitch}" Content="Start with Windows" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkCloseToTray" Style="{StaticResource ModernSwitch}" Content="Minimize to System Tray on Close" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1.5,0,0" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Style="{StaticResource GlowButton}" Content="Cancel" Margin="0,0,10,0" Padding="18,7" Click="CloseBtn_Click"/>
                    <Button Style="{StaticResource PrimaryEmeraldButton}" Content="Save Settings" Padding="22,7" Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
