<Window x:Class="MacroMaster.UI.Windows.ActiveScriptsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        xmlns:models="clr-namespace:MacroMaster.Core.Models"
        Title="Active Scripts - MacroMaster"
        Icon="/Assets/app.ico"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1.5" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon IconKey="zap" Foreground="{StaticResource NeonEmeraldGlowBrush}" Size="20" StrokeThickness="2.8" Margin="0,0,10,0"/>
                        <TextBlock Text="Active Scripts &amp; Triggers" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Click="CloseBtn_Click">
                        <controls:LucideIcon IconKey="x" Foreground="{StaticResource TextSecondaryBrush}" Size="18" StrokeThickness="2.6"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="18,14,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary Header Banner -->
                <Border Grid.Row="0" Background="#131B2A" BorderBrush="{StaticResource NeonEmeraldBrush}" BorderThickness="2" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource NeonEmeraldGlowBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtSummary" Text="3 Active Scripts Armed in Profile: Destiny 2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active Scripts List -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="10">
                    <ListBox x:Name="ActiveScriptsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MacroDefinition}">
                                <Border Background="#131724" BorderBrush="#2F3C56" BorderThickness="2" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Toggle Switch -->
                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernSwitch}" IsChecked="{Binding IsEnabled}" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Toggle Enabled/Disabled"/>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel Margin="0,0,0,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                                <Border Background="#1C2436" BorderBrush="#3B4C6F" BorderThickness="1.5" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource NeonVioletGlowBrush}"/>
                                                </Border>
                                                <Border Visibility="{Binding RequiresArming, Converter={StaticResource BoolToVis}}" Background="#1A2E2A" BorderBrush="{StaticResource NeonEmeraldBrush}" BorderThickness="1.5" CornerRadius="5" Padding="7,2">
                                                    <TextBlock Text="{Binding ArmingDisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldGlowBrush}"/>
                                                </Border>
                                            </WrapPanel>

                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="Trigger: " FontSize="13.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Border Background="#1C283E" CornerRadius="4" Padding="6,1.5" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Trigger.DisplayString}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                                <TextBlock Text="Target: " FontSize="13.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding ProcessFilter}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Status Indicator Badge -->
                                        <Border Grid.Column="2" Background="#172722" BorderBrush="{StaticResource NeonEmeraldBrush}" BorderThickness="2" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="ACTIVE" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldGlowBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1.5,0,0" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Style="{StaticResource PrimaryEmeraldButton}" Content="Done" Padding="24,7" Click="CloseBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
