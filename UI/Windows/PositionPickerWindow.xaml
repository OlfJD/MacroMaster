<!-- Settings → position "Custom": a stand-in for the popup that you drag where you want it.
     Enter / double-click / clicking elsewhere keeps the spot, Esc cancels. -->
<Window x:Class="MacroMaster.UI.Windows.PositionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Title="Place it - MacroMaster"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource RaisedBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="{DynamicResource UiTextFormattingMode}"
        Cursor="SizeAll">

    <controls:SmoothBorder x:Name="Frame" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Padding="14,10,16,10">
        <StackPanel Orientation="Horizontal">
            <controls:AppIcon x:Name="SampleIcon" IconKey="crosshair" Size="16" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SampleText" Text="Notifications show up here" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Drag me where you want me · Enter to keep · Esc to cancel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </controls:SmoothBorder>
</Window>
