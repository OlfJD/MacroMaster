<Window x:Class="MacroMaster.UI.Windows.ModeIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMaster mode indicator"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource RaisedBrush}"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="{DynamicResource UiTextFormattingMode}"
        TextOptions.TextRenderingMode="ClearType">

    <!-- The always-visible "which mode is active" label. Solid window like the notification popup
         (keeps text crisp); click-through and slight see-through are Win32 window styles set in code. -->
    <StackPanel Orientation="Horizontal" Margin="10,5,12,6">
        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
        <TextBlock x:Name="ModeText" Text="Mode" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</Window>
