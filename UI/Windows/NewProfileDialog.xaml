<Window x:Class="MacroMaster.UI.Windows.NewProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Style="{StaticResource AppWindow}"
        Title="New profile - MacroMaster"
        Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,0,10,0">
            <TextBlock x:Name="TxtHeader" Text="New profile" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CloseBtn_Click" ToolTip="Close">
                <controls:AppIcon IconKey="x" Size="16"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtProfileName" Style="{StaticResource Input}" Tag="e.g. Destiny 2" Margin="0,0,0,16"/>

            <TextBlock Text="Game or app" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtProcessFilter" Style="{StaticResource Input}" Tag="game.exe — leave empty for all apps"/>
            <TextBlock Text="If set, this profile's macros only fire while that app is in front." Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" Click="CloseBtn_Click"/>
                <Button x:Name="BtnCreate" Style="{StaticResource PrimaryButton}" Content="Create profile" MinWidth="84" IsDefault="True" Click="CreateBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
