<Window x:Class="MacroMaster.UI.Windows.NewProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        Title="New Profile - MacroMaster"
        Icon="/Assets/app.ico"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1.5" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon IconKey="layers" Foreground="{StaticResource NeonEmeraldGlowBrush}" Size="20" StrokeThickness="2.8" Margin="0,0,10,0"/>
                        <TextBlock Text="Create New Profile" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Click="CloseBtn_Click">
                        <controls:LucideIcon IconKey="x" Foreground="{StaticResource TextSecondaryBrush}" Size="18" StrokeThickness="2.6"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <TextBlock Text="Profile Name" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtProfileName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" Text="New Profile"/>

                <TextBlock Text="Target Process Filter (e.g. game.exe or * for Global)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtProcessFilter" Style="{StaticResource ModernTextBox}" Text="*"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1.5,0,0" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Style="{StaticResource GlowButton}" Content="Cancel" Margin="0,0,10,0" Padding="18,7" Click="CloseBtn_Click"/>
                    <Button Style="{StaticResource PrimaryEmeraldButton}" Content="Create Profile" Padding="22,7" Click="CreateBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
