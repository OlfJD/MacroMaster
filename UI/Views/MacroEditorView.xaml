<!-- The macro editor is a page inside the main window (MainWindow.EditorHost), not a window of its own.
     Its top row is 44 px to line up with the main window's caption strip. -->
<UserControl x:Class="MacroMaster.UI.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
             xmlns:models="clr-namespace:MacroMaster.Core.Models"
             xmlns:ed="clr-namespace:MacroMaster.UI.Editor"
             Focusable="False">

    <UserControl.Resources>
        <ed:KeyLabelConverter x:Key="KeyLabel"/>
        <ed:DepthToMarginConverter x:Key="DepthMargin"/>
        <ed:HexToBrushConverter x:Key="HexBrush"/>

        <!-- Numbered section heading: "1  Hotkey" + one plain sentence -->
        <Style x:Key="StepNumber" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNumberText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Compact (28 px) controls used inside step rows -->
        <Style x:Key="StepInput" TargetType="{x:Type TextBox}" BasedOn="{StaticResource InputSm}">
            <Setter Property="Width" Value="64"/>
        </Style>
        <Style x:Key="StepCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="DisplayMemberPath" Value="Label"/>
            <Setter Property="SelectedValuePath" Value="Value"/>
        </Style>
        <Style x:Key="InlineText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Keycap-looking button: click, then press the key -->
        <Style x:Key="KeyButton" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1,1,1,2" CornerRadius="{StaticResource RadiusSm}" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Inline step editors ===== -->
        <DataTemplate x:Key="KeyStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Style="{StaticResource StepCombo}" Width="112" ItemsSource="{x:Static ed:StepChoices.KeyTypes}" SelectedValue="{Binding Type}"/>
                <Button x:Name="KeyBtn" Style="{StaticResource KeyButton}" Margin="8,0,0,0" Click="StepKey_Click" ToolTip="Click, then press the key">
                    <TextBlock x:Name="KeyText" Text="{Binding Key, Converter={StaticResource KeyLabel}}" FontWeight="SemiBold" FontSize="13"/>
                </Button>
                <StackPanel x:Name="HoldPart" Orientation="Horizontal">
                    <TextBlock Text="for" Style="{StaticResource InlineText}"/>
                    <TextBox Style="{StaticResource StepInput}" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ms" Style="{StaticResource InlineText}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.KeyDown}">
                    <Setter TargetName="HoldPart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.KeyUp}">
                    <Setter TargetName="HoldPart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="">
                    <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCapturingKey}" Value="True">
                    <Setter TargetName="KeyText" Property="Text" Value="Press a key…"/>
                    <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MouseStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <ComboBox Style="{StaticResource StepCombo}" Width="112" ItemsSource="{x:Static ed:StepChoices.MouseTypes}" SelectedValue="{Binding Type}"/>
                <ComboBox x:Name="ButtonPart" Style="{StaticResource StepCombo}" Width="140" Margin="8,0,0,0" ItemsSource="{x:Static ed:StepChoices.MouseButtons}" SelectedValue="{Binding MouseButton}"/>
                <StackPanel x:Name="HoldPart" Orientation="Horizontal">
                    <TextBlock Text="for" Style="{StaticResource InlineText}"/>
                    <TextBox Style="{StaticResource StepInput}" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ms" Style="{StaticResource InlineText}"/>
                </StackPanel>
                <StackPanel x:Name="ScrollPart" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="by" Style="{StaticResource InlineText}"/>
                    <TextBox Style="{StaticResource StepInput}" Text="{Binding MouseDelta, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="120 is one notch up, -120 one notch down"/>
                    <TextBlock Text="(120 = one notch up)" Style="{StaticResource InlineText}" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.MouseDown}">
                    <Setter TargetName="HoldPart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.MouseUp}">
                    <Setter TargetName="HoldPart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.MouseScroll}">
                    <Setter TargetName="HoldPart" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ButtonPart" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ScrollPart" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="WaitStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Wait" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ms, give or take" Style="{StaticResource InlineText}"/>
                <TextBox Style="{StaticResource StepInput}" Width="52" Text="{Binding RandomJitterMs, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Makes the wait a little different each time (0 = always exact)"/>
                <TextBlock Text="ms" Style="{StaticResource InlineText}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MoveStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Move mouse" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding MoveX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels right (negative = left)"/>
                <TextBlock Text="right," Style="{StaticResource InlineText}"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding MoveY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels down (negative = up)"/>
                <TextBlock Text="down (px)" Style="{StaticResource InlineText}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextStepTemplate" DataType="{x:Type models:MacroAction}">
            <DockPanel>
                <TextBlock Text="Type" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource InputSm}" TextAlignment="Left" Padding="8,0" MinWidth="220" MaxWidth="420" HorizontalAlignment="Left"
                         Tag="Text to type, e.g. gg wp" Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Typed letter by letter, the same on every keyboard layout"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Media key" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <ComboBox Style="{StaticResource StepCombo}" Width="160" ItemsSource="{x:Static ed:StepChoices.MediaCommands}" SelectedValue="{Binding MediaCommand}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Move the pointer to an exact spot on the screen -->
        <DataTemplate x:Key="MoveToStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Move mouse to" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding MoveX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels from the left edge of the main screen"/>
                <TextBlock Text="," Style="{StaticResource InlineText}" Margin="4,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding MoveY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels from the top edge of the main screen"/>
                <Button Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Margin="10,0,0,0" Click="StepPick_Click"
                        ToolTip="Click, then click the spot on your screen (right click or Esc cancels)">
                    <TextBlock x:Name="PickText" Text="Pick"/>
                </Button>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCapturingKey}" Value="True">
                    <Setter TargetName="PickText" Property="Text" Value="Click the spot…"/>
                    <Setter TargetName="PickText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Wait until one screen pixel has a colour (e.g. an ability icon lighting up) -->
        <DataTemplate x:Key="PixelStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Wait for pixel" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Width="50" Text="{Binding MoveX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels from the left edge of the main screen"/>
                <TextBlock Text="," Style="{StaticResource InlineText}" Margin="4,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Width="50" Text="{Binding MoveY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pixels from the top edge of the main screen"/>
                <TextBlock Text="is" Style="{StaticResource InlineText}"/>
                <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusSm}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        Background="{Binding TextContent, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource StepInput}" Width="78" Tag="#RRGGBB" Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="The colour to wait for, e.g. #FFCC00. Close matches count."/>
                <TextBlock Text="up to" Style="{StaticResource InlineText}"/>
                <TextBox Style="{StaticResource StepInput}" Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="If the colour hasn't shown up after this long, the rest of the macro is skipped (0 = wait forever)"/>
                <TextBlock Text="ms" Style="{StaticResource InlineText}"/>
                <Button Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Margin="2,0,0,0" Click="StepPick_Click"
                        ToolTip="Click, then click the pixel on your screen: its position and colour are filled in (right click or Esc cancels)">
                    <TextBlock x:Name="PickText" Text="Pick"/>
                </Button>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCapturingKey}" Value="True">
                    <Setter TargetName="PickText" Property="Text" Value="Click the pixel…"/>
                    <Setter TargetName="PickText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Repeat block: everything between this row and its "End of repeat" row -->
        <DataTemplate x:Key="RepeatStartStepTemplate" DataType="{x:Type models:MacroAction}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Repeat the steps below" Style="{StaticResource InlineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBox Style="{StaticResource StepInput}" Width="52" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="times" Style="{StaticResource InlineText}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RepeatEndStepTemplate" DataType="{x:Type models:MacroAction}">
            <TextBlock Text="End of repeat" Style="{StaticResource InlineText}" Margin="0"
                       ToolTip="Drag this row to choose which steps are repeated"/>
        </DataTemplate>

        <DataTemplate x:Key="OtherStepTemplate" DataType="{x:Type models:MacroAction}">
            <TextBlock Text="{Binding DisplayText}" Style="{StaticResource InlineText}" Margin="0"/>
        </DataTemplate>

        <ed:StepTemplateSelector x:Key="StepSelector"
                                 KeyTemplate="{StaticResource KeyStepTemplate}"
                                 MouseTemplate="{StaticResource MouseStepTemplate}"
                                 WaitTemplate="{StaticResource WaitStepTemplate}"
                                 MoveTemplate="{StaticResource MoveStepTemplate}"
                                 TextTemplate="{StaticResource TextStepTemplate}"
                                 MediaTemplate="{StaticResource MediaStepTemplate}"
                                 MoveToTemplate="{StaticResource MoveToStepTemplate}"
                                 PixelTemplate="{StaticResource PixelStepTemplate}"
                                 RepeatStartTemplate="{StaticResource RepeatStartStepTemplate}"
                                 RepeatEndTemplate="{StaticResource RepeatEndStepTemplate}"
                                 OtherTemplate="{StaticResource OtherStepTemplate}"/>

        <!-- One step row: number, icon, inline editor, row actions -->
        <DataTemplate x:Key="StepRowTemplate" DataType="{x:Type models:MacroAction}">
            <controls:SmoothBorder x:Name="Row" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="{Binding Depth, Converter={StaticResource DepthMargin}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- The step number doubles as the drag handle (see StepGrip_MouseDown / ActionsList_MouseMove) -->
                    <Border Background="Transparent" Margin="-10,-8,0,-8" Padding="10,0,0,0" Cursor="SizeNS" ToolTip="Drag to reorder"
                            MouseLeftButtonDown="StepGrip_MouseDown">
                        <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexPlusOne}}"
                                   FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="0,0,12,0">
                        <controls:AppIcon IconKey="{Binding IconKey}" Size="16" Foreground="{StaticResource AccentTextBrush}"/>
                    </Border>
                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplateSelector="{StaticResource StepSelector}" VerticalAlignment="Center" Focusable="False"/>
                    <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal" Opacity="0" Margin="8,0,0,0">
                        <Button Style="{StaticResource IconButton}" Click="StepDuplicate_Click" ToolTip="Duplicate">
                            <controls:AppIcon IconKey="copy" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="StepMoveUp_Click" ToolTip="Move up">
                            <controls:AppIcon IconKey="arrow-up" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="StepMoveDown_Click" ToolTip="Move down">
                            <controls:AppIcon IconKey="arrow-down" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource DangerIconButton}" Click="StepDelete_Click" ToolTip="Remove">
                            <controls:AppIcon IconKey="trash-2" Size="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:SmoothBorder>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowActions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowActions" Storyboard.TargetProperty="Opacity" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <!-- The row being dragged to a new position -->
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- breadcrumb, inside the window's caption strip -->
            <RowDefinition Height="Auto"/> <!-- name -->
            <RowDefinition Height="*"/>    <!-- body -->
            <RowDefinition Height="Auto"/> <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Breadcrumb: "← Macros / New macro". The window's own caption buttons sit on top at the right. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Style="{StaticResource GhostButtonSm}" Margin="0" Padding="8,0" Click="CancelBtn_Click"
                    ToolTip="Back to your macros without saving" AutomationProperties.Name="Back to macros">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon IconKey="arrow-left" Size="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Macros" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="/" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <TextBlock x:Name="TxtCaption" Text="New macro" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Name -->
        <TextBox x:Name="TxtName" Grid.Row="1" Style="{StaticResource TitleInput}" Tag="Name your macro" Margin="24,0,24,20" MaxWidth="560" HorizontalAlignment="Left" MinWidth="320"/>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT: hotkey, how often, more ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
                <StackPanel Margin="0,0,8,24">

                    <!-- 1 Hotkey -->
                    <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}"/></Border>
                                <StackPanel>
                                    <TextBlock Text="Hotkey" Style="{StaticResource H3}"/>
                                    <TextBlock Text="What you press to start it." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="HotkeyBox" Click="HotkeyBox_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <controls:SmoothBorder x:Name="Bd" Background="{StaticResource BgBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" MinHeight="56" Padding="14,10">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </controls:SmoothBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource BorderStrongColor}"/>
                                </Button.BorderBrush>
                                <Grid>
                                    <ItemsControl x:Name="HotkeyCaps" ItemTemplate="{StaticResource KeycapTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HotkeyPrompt" Text="Click here, then press your hotkey" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="HotkeyHint" Text="Combinations work too: hold Ä + Ö and press L. Mouse side buttons work as well."
                                           Style="{StaticResource Hint}" Margin="0,0,56,0"/>
                                <Button x:Name="BtnClearHotkey" Style="{StaticResource GhostButtonSm}" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Content="Clear" Click="ClearHotkey_Click"/>
                            </Grid>

                            <!-- Conflict warning -->
                            <Border x:Name="ConflictBox" Style="{StaticResource Callout}" Background="{StaticResource WarningSubtleBrush}" Margin="0,12,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:AppIcon IconKey="alert" Size="16" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                    <TextBlock x:Name="ConflictText" Grid.Column="1" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </controls:SmoothBorder>

                    <!-- 2 How often -->
                    <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}"/></Border>
                                <StackPanel>
                                    <TextBlock Text="How often" Style="{StaticResource H3}"/>
                                    <TextBlock Text="What happens each time you press the hotkey." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </StackPanel>

                            <RadioButton x:Name="RadioOnce" Style="{StaticResource OptionCard}" GroupName="Mode" IsChecked="True">
                                <StackPanel>
                                    <TextBlock Text="Once" FontWeight="SemiBold"/>
                                    <TextBlock Text="Plays the steps one time." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioRepeat" Style="{StaticResource OptionCard}" GroupName="Mode">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Repeat" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtRepeatCount" Style="{StaticResource InputSm}" Width="52"
                                                 Margin="8,0" Text="3" GotKeyboardFocus="TxtRepeatCount_GotFocus"/>
                                        <TextBlock Text="times" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Plays the steps several times in a row." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioLoop" Style="{StaticResource OptionCard}" GroupName="Mode">
                                <StackPanel>
                                    <TextBlock Text="Loop until pressed again" FontWeight="SemiBold"/>
                                    <TextBlock Text="Press once to start, press again to stop." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioHold" Style="{StaticResource OptionCard}" GroupName="Mode" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="While held" FontWeight="SemiBold"/>
                                    <TextBlock Text="Repeats the steps for as long as you hold the hotkey." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </controls:SmoothBorder>

                    <!-- More options -->
                    <ToggleButton x:Name="MoreToggle" Cursor="Hand" FocusVisualStyle="{x:Null}" Checked="MoreToggle_Changed" Unchecked="MoreToggle_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Background="Transparent" Padding="4,6">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon x:Name="Chevron" IconKey="chevron-right" Size="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="More options" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="MoreSummary" Text="  note, category, app, mode group" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="IconKey" Value="chevron-down"/>
                                        <Setter TargetName="MoreSummary" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <controls:SmoothBorder x:Name="MorePanel" Style="{StaticResource Card}" Margin="0,6,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtDescription" Style="{StaticResource Input}" Tag="What it's for (optional)" Margin="0,0,0,14"/>

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCategory" Style="{StaticResource Input}" Tag="General" Margin="0,0,0,14"/>

                            <TextBlock Text="Only while this app is in front" Style="{StaticResource FieldLabel}"/>
                            <Button x:Name="AppPickerBtn" Style="{StaticResource PickerButton}" Click="AppPicker_Click"
                                    ToolTip="Pick the game or app this macro is for. Elsewhere the hotkey does nothing.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <controls:AppIcon x:Name="AppPickerGlyph" IconKey="apps" Size="16" Foreground="{StaticResource TextMutedBrush}"/>
                                        <Image x:Name="AppPickerImage" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AppPickerText" Text="Any app" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="AppPickerSub" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <controls:AppIcon Grid.Column="2" IconKey="chevron-down" Size="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>

                            <Popup x:Name="AppPopup" PlacementTarget="{Binding ElementName=AppPickerBtn}" Placement="Bottom" VerticalOffset="4"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="AppPopup_Closed">
                                <controls:SmoothBorder Style="{StaticResource PopupPanel}" Width="340">
                                    <StackPanel>
                                        <Grid Margin="2,2,2,6">
                                            <TextBox x:Name="TxtAppSearch" Style="{StaticResource Input}" Padding="32,0,10,0" Tag="Search running apps"
                                                     TextChanged="TxtAppSearch_TextChanged" PreviewKeyDown="TxtAppSearch_PreviewKeyDown"/>
                                            <controls:AppIcon IconKey="search" Size="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>

                                        <TextBlock Text="RUNNING NOW" Style="{StaticResource SectionLabel}" Margin="10,4,0,4"/>
                                        <Grid>
                                            <ListBox x:Name="AppList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PickerItem}" MaxHeight="264"
                                                     PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type ed:RunningApp}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <controls:AppIcon IconKey="apps" Size="16" Foreground="{StaticResource TextMutedBrush}"/>
                                                                <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ExeName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="AppListStatus" Text="Looking for open apps…" Style="{StaticResource Caption}" Margin="10,10" TextWrapping="Wrap"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BorderStrongBrush}" Margin="4,6"/>
                                        <Button Style="{StaticResource GhostButton}" Padding="10,0" HorizontalAlignment="Stretch" Click="AppAny_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon IconKey="monitor" Size="16" Margin="0,0,10,0"/>
                                                <TextBlock Text="Any app (works everywhere)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="10,0" HorizontalAlignment="Stretch" Click="AppBrowse_Click"
                                                ToolTip="For a game that isn't running right now">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon IconKey="folder-open" Size="16" Margin="0,0,10,0"/>
                                                <TextBlock Text="Browse for an .exe…" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:SmoothBorder>
                            </Popup>

                            <Border Style="{StaticResource Divider}" Margin="0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Part of a mode group" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Several macros share one hotkey and a switch key picks which one runs (e.g. PgUp = Wellskate, PgDn = Groundskate)."
                                               Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkRequiresArming" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                          Checked="ChkRequiresArming_Checked" Unchecked="ChkRequiresArming_Checked"/>
                            </Grid>

                            <StackPanel x:Name="ArmingConfigPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtArmingGroup" Style="{StaticResource Input}" Tag="e.g. Skate modes" TextChanged="TxtArmingGroup_TextChanged"/>
                                <WrapPanel x:Name="GroupSuggestions" Margin="0,6,0,0"/>
                                <Border x:Name="GroupMembersBox" Style="{StaticResource Callout}" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:AppIcon IconKey="link" Size="12" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <TextBlock x:Name="GroupMembersText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Switch key" Style="{StaticResource FieldLabel}"/>
                                        <Button x:Name="ArmKeyBtn" Style="{StaticResource KeyButton}" Height="32" MinWidth="84" HorizontalAlignment="Left" Click="ArmKey_Click"
                                                ToolTip="Click, then press the key that makes this mode active">
                                            <TextBlock x:Name="ArmKeyText" Text="Set key" FontWeight="SemiBold" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mode name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtArmingName" Style="{StaticResource Input}" Tag="e.g. Wellskate"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Pressing the switch key makes this macro the active one in its group. The key still reaches the game."
                                           Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SmoothBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ RIGHT: 3 Steps ============ -->
            <Grid Grid.Column="2" Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepNumberText}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Steps" Style="{StaticResource H3}"/>
                            <TextBlock x:Name="TxtTimelineSummary" Text="What it does, top to bottom." Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="StepToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SmoothBorder Style="{StaticResource SegmentGroup}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButtonSm}" Click="AddKeyTap_Click" ToolTip="Add a key press — you'll be asked which key">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon IconKey="plus" Size="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Key" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonSm}" Click="AddMouseClick_Click" ToolTip="Add a mouse click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon IconKey="plus" Size="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Click" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonSm}" Click="AddDelay_Click" ToolTip="Add a pause">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon IconKey="plus" Size="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Wait" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Less common steps live in a menu so the toolbar still fits at the minimum window width -->
                                <Button Style="{StaticResource GhostButtonSm}" Click="MoreSteps_Click" AutomationProperties.Name="More steps"
                                        ToolTip="Move the mouse, type text, press a media key, wait for a pixel or repeat steps">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon IconKey="plus" Size="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="More" VerticalAlignment="Center"/>
                                        <controls:AppIcon IconKey="chevron-down" Size="12" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Placement="Bottom" VerticalOffset="4">
                                            <MenuItem Header="Move the mouse" Click="AddMouseMove_Click" ToolTip="By a few pixels, e.g. recoil control">
                                                <MenuItem.Icon><controls:AppIcon IconKey="crosshair" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Type text" Click="AddText_Click" ToolTip="Types a word or sentence, e.g. a chat message">
                                                <MenuItem.Icon><controls:AppIcon IconKey="type" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Media key" Click="AddMedia_Click" ToolTip="Play/pause, next track, volume…">
                                                <MenuItem.Icon><controls:AppIcon IconKey="play" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Move the mouse to a spot" Click="AddMoveTo_Click" ToolTip="Puts the pointer on an exact position on the screen">
                                                <MenuItem.Icon><controls:AppIcon IconKey="crosshair" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Wait for a pixel colour" Click="AddPixel_Click" ToolTip="Waits until a spot on the screen has a certain colour, e.g. an ability icon lighting up">
                                                <MenuItem.Icon><controls:AppIcon IconKey="monitor" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Repeat a block of steps" Click="AddRepeat_Click" ToolTip="Adds a start and an end row; the steps between them run several times">
                                                <MenuItem.Icon><controls:AppIcon IconKey="repeat" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </controls:SmoothBorder>
                        <Button x:Name="BtnRecord" Style="{StaticResource SecondaryButton}" Click="BtnRecord_Click"
                                ToolTip="Do the sequence yourself and it's turned into steps">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon x:Name="RecordIcon" IconKey="circle-dot" Size="16" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RecordText" Text="Record" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <controls:SmoothBorder Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActionsList" ItemTemplate="{StaticResource StepRowTemplate}" AlternationCount="100000" Focusable="False"
                                          MouseMove="ActionsList_MouseMove" MouseLeftButtonUp="ActionsList_MouseUp" LostMouseCapture="ActionsList_LostCapture"/>
                        </ScrollViewer>

                        <!-- Recording banner -->
                        <Border x:Name="RecordingBanner" Style="{StaticResource Callout}" VerticalAlignment="Bottom" Margin="4"
                                Background="{StaticResource DangerSubtleBrush}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recording — switch to your game and do the sequence. Clicks on this window aren't recorded."
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Getting started: shown while there are no steps -->
                        <StackPanel x:Name="StepsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="How do you want to start?" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock Text="You can change everything afterwards." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,18"/>
                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource SecondaryButton}" Height="Auto" Padding="12,14" Margin="0,0,8,0" Click="BtnRecord_Click" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <controls:AppIcon IconKey="circle-dot" Size="20" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Record it" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Do it once yourself" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="Auto" Padding="12,14" Margin="4,0" Click="TemplateAutoClicker_Click" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <controls:AppIcon IconKey="mouse" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Auto clicker" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Clicks until stopped" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Height="Auto" Padding="12,14" Margin="8,0,0,0" Click="TemplateKeySpam_Click" HorizontalContentAlignment="Stretch">
                                    <StackPanel>
                                        <controls:AppIcon IconKey="keyboard" Size="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Spam a key" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Presses until stopped" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock Text="…or build it step by step with the + buttons above." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>
                </controls:SmoothBorder>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AppIcon x:Name="FooterIcon" IconKey="alert" Size="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtFooterHint" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="CancelBtn_Click"/>
                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Content="Save macro" MinWidth="110" Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
