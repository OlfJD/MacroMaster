<!-- Settings is a page inside the main window (MainWindow.ShowPage), like the macro editor.
     Its top row is 44 px to line up with the main window's caption strip. -->
<UserControl x:Class="MacroMaster.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
             Focusable="False">

    <UserControl.Resources>
        <!-- One settings row: RowTitle + Hint on the left, control on the right -->
        <Style x:Key="RowDivider" TargetType="{x:Type Border}" BasedOn="{StaticResource Divider}">
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="CaptureButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb: "← Macros / Settings" (same as the macro editor page) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Style="{StaticResource GhostButtonSm}" Margin="0" Padding="8,0" Click="CloseBtn_Click"
                    ToolTip="Back to your macros without saving" AutomationProperties.Name="Back to macros">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon IconKey="arrow-left" Size="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Macros" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="/" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <TextBlock Text="Settings" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,18,24">
            <!-- One centred column: settings rows get hard to scan when they stretch across a wide window -->
            <StackPanel Margin="0,0,6,0" MaxWidth="720">
                <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20"/>

                <!-- GLOBAL KEYS: work everywhere, even while the engine is paused -->
                <TextBlock Text="GLOBAL KEYS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid ToolTip="One key that works everywhere, even in a game and even while the engine is off. Press it to switch every hotkey off (running macros stop and anything they hold is let go), press it again to switch them back on.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="32" Height="32" Background="{StaticResource DangerSubtleBrush}" Margin="0,0,12,0">
                                <controls:AppIcon IconKey="power" Size="16" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Engine on / off" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Flips the engine switch. Off stops every macro, releases all held keys and buttons, and ignores every hotkey until you press it again. Leave empty for no key."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtEngineToggle" Style="{StaticResource HotkeyBox}" Text="F12" Tag="None"/>
                                <Button x:Name="BtnCaptureEngineToggle" Style="{StaticResource CaptureButton}" Content="Capture" Click="BtnCaptureEngineToggle_Click" ToolTip="Click, then press a key"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="Handy in a game: press it to pull MacroMaster in front, edit a macro, press it again and you're back in the game.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="32" Height="32" Background="{StaticResource AccentSubtleBrush}" Margin="0,0,12,0">
                                <controls:AppIcon IconKey="zap" Size="16" Foreground="{StaticResource AccentTextBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Quick open" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Brings MacroMaster in front of everything, e.g. to make a macro mid-game. Press it again to send it back. Leave empty to turn it off."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtQuickOpen" Style="{StaticResource HotkeyBox}" Tag="None"/>
                                <Button x:Name="BtnCaptureQuickOpen" Style="{StaticResource CaptureButton}" Content="Capture" Click="BtnCaptureQuickOpen_Click" ToolTip="Click, then press a key"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>

                <!-- OVERLAY -->
                <TextBlock Text="ON-SCREEN OVERLAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid ToolTip="Pops up for a moment when a macro starts or stops, a mode is switched or the engine goes on or off. It never takes the focus away from your game and disappears as soon as the mouse touches it.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Show notifications" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A small banner when a macro starts, stops or a mode is armed." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="BtnPreviewHud" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Show preview" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Click="BtnPreviewHud_Click" ToolTip="Shows an example notification in the position chosen below"/>
                            <CheckBox x:Name="ChkShowOverlay" Grid.Column="2" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Show notifications"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="Where on the screen notifications appear. They always show on the monitor of the app in front, so on the monitor you're playing on. Pick Custom to drag them to any spot.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPlaceHud" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Place it…" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Click="BtnPlaceHud_Click" Visibility="Collapsed" ToolTip="Drag a stand-in to the spot you want"/>
                            <ComboBox x:Name="CmbHudPosition" Grid.Column="2" Width="208" SelectionChanged="CmbHudPosition_SelectionChanged"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="How long a notification stays on screen, in milliseconds (1000 ms = 1 second). The shortest is 500.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duration" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHudDuration" Grid.Column="1" Style="{StaticResource HotkeyBox}" Text="2200"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Width="90"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <!-- Mode indicator: stays on screen (the banner above comes and goes) -->
                        <Grid ToolTip="Shows the active mode of your mode groups (e.g. Wellskate) while their game is in front, and loops that are running, if the macro has &quot;Show on the mode indicator&quot; switched on in the editor. It stays on screen and clicks pass straight through it.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Mode indicator" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A small label that stays on screen and shows the active mode and running loops. Clicks pass through it."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="BtnPreviewIndicator" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Show preview" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Click="BtnPreviewIndicator_Click" ToolTip="Shows the indicator for a few seconds, in the position chosen below"/>
                            <CheckBox x:Name="ChkModeIndicator" Grid.Column="2" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Mode indicator"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="Where on the screen the mode indicator sits. Pick Custom to drag it to any spot.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Indicator position" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPlaceIndicator" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Place it…" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Click="BtnPlaceIndicator_Click" Visibility="Collapsed" ToolTip="Drag a stand-in to the spot you want"/>
                            <ComboBox x:Name="CmbIndicatorPosition" Grid.Column="2" Width="208" SelectionChanged="CmbIndicatorPosition_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>

                <!-- DISPLAY -->
                <TextBlock Text="DISPLAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,24">
                    <Grid ToolTip="How big buttons and text are. Auto looks at the screen MacroMaster is on and grows everything on bigger screens (133 % on 1440p, 200 % on 4K). Pick a number to use that size everywhere.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Interface size" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="TxtUiScaleHint" Style="{StaticResource Hint}"
                                       Text="Auto grows the interface with bigger screens, so it looks the same on 1080p, 1440p and 4K."/>
                        </StackPanel>
                        <ComboBox x:Name="CmbUiScale" Grid.Column="1" Width="208" VerticalAlignment="Center"/>
                    </Grid>
                </controls:SmoothBorder>

                <!-- SYSTEM -->
                <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid ToolTip="MacroMaster starts by itself when you sign in to Windows and waits in the tray (the small icons next to the clock), so your hotkeys are ready without opening it.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Launches quietly in the tray when you sign in." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Style="{StaticResource Switch}" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed"/>
                        </Grid>

                        <Grid x:Name="StartAsAdminRow" Margin="0,12,0,0"
                              ToolTip="Some games and tools run as administrator, and Windows hides your key presses in them from normal programs, so hotkeys would do nothing there. Started as administrator, MacroMaster works in those too. Windows asks for permission once when you save; after that it starts without asking. Downside: you can't drag files from Explorer onto an administrator window.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="20,0,16,0">
                                <TextBlock Text="As administrator" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="TxtStartAsAdminHint" Text="So hotkeys also work in games that run as administrator. Windows asks once when you save." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkStartAsAdmin" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Start as administrator"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="On: the minimize button hides MacroMaster in the tray (next to the clock) instead of the taskbar. Click the tray icon to bring it back.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Minimize to tray" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="The minimize button hides the window instead of using the taskbar." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="On: closing the window (X) only hides it and your hotkeys keep working. To really quit, right-click the tray icon and choose Exit. Off: closing the window quits MacroMaster.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Keep running when closed" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Closing the window keeps hotkeys active from the tray." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCloseToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="Restarts MacroMaster right now with administrator rights (Windows asks for permission), until you close it. To always start that way, use Start with Windows → As administrator above.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Administrator rights" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="TxtAdminHint" Style="{StaticResource Hint}"
                                           Text="Windows hides key presses made in apps that run as administrator from normal programs, so hotkeys do nothing there. Restart MacroMaster as administrator to use it in those apps."/>
                            </StackPanel>
                            <Button x:Name="BtnRestartAsAdmin" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Restart as administrator"
                                    VerticalAlignment="Center" Click="BtnRestartAsAdmin_Click"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid ToolTip="MacroMaster checks GitHub for a new version when it starts and every few hours. A new version is downloaded in the background and installed the next time no macro is running and you're not editing; MacroMaster restarts by itself in a second and keeps your macros and settings.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Update automatically" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="TxtUpdateHint" Text="Installs new versions from GitHub quietly in the background." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoUpdate" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Update automatically"/>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" Click="CloseBtn_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" MinWidth="84" Click="SaveBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
