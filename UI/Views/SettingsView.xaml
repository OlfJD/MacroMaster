<!-- Settings is a page inside the main window (MainWindow.ShowPage), like the macro editor.
     Its top row is 44 px to line up with the main window's caption strip. -->
<UserControl x:Class="MacroMaster.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
             Focusable="False">

    <UserControl.Resources>
        <!-- One settings row: RowTitle + Hint on the left, control on the right -->
        <Style x:Key="RowDivider" TargetType="{x:Type Border}" BasedOn="{StaticResource Divider}">
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="CaptureButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb: "← Macros / Settings" (same as the macro editor page) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Style="{StaticResource GhostButtonSm}" Margin="0" Padding="8,0" Click="CloseBtn_Click"
                    ToolTip="Back to your macros without saving" AutomationProperties.Name="Back to macros">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon IconKey="arrow-left" Size="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Macros" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="/" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <TextBlock Text="Settings" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,18,24">
            <!-- One centred column: settings rows get hard to scan when they stretch across a wide window -->
            <StackPanel Margin="0,0,6,0" MaxWidth="720">
                <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20"/>

                <!-- GLOBAL KEYS: work everywhere, even while the engine is paused -->
                <TextBlock Text="GLOBAL KEYS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="32" Height="32" Background="{StaticResource DangerSubtleBrush}" Margin="0,0,12,0">
                                <controls:AppIcon IconKey="power" Size="16" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Engine on / off" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Flips the engine switch. Off stops every macro, releases all held keys and buttons, and ignores every hotkey until you press it again. Leave empty for no key."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtEngineToggle" Style="{StaticResource HotkeyBox}" Text="F12" Tag="None"/>
                                <Button x:Name="BtnCaptureEngineToggle" Style="{StaticResource CaptureButton}" Content="Capture" Click="BtnCaptureEngineToggle_Click" ToolTip="Click, then press a key"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="32" Height="32" Background="{StaticResource AccentSubtleBrush}" Margin="0,0,12,0">
                                <controls:AppIcon IconKey="zap" Size="16" Foreground="{StaticResource AccentTextBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Quick open" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Brings MacroMaster in front of everything, e.g. to make a macro mid-game. Press it again to send it back. Leave empty to turn it off."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtQuickOpen" Style="{StaticResource HotkeyBox}" Tag="None"/>
                                <Button x:Name="BtnCaptureQuickOpen" Style="{StaticResource CaptureButton}" Content="Capture" Click="BtnCaptureQuickOpen_Click" ToolTip="Click, then press a key"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>

                <!-- OVERLAY -->
                <TextBlock Text="ON-SCREEN OVERLAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Show notifications" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A small banner when a macro starts, stops or a mode is armed." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkShowOverlay" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbHudPosition" Grid.Column="1" Width="208">
                                <ComboBoxItem Content="Top center"/>
                                <ComboBoxItem Content="Top right (default)"/>
                                <ComboBoxItem Content="Bottom right"/>
                                <ComboBoxItem Content="Bottom center"/>
                                <ComboBoxItem Content="Top left"/>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duration" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHudDuration" Grid.Column="1" Style="{StaticResource HotkeyBox}" Text="2200"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Width="90"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <!-- Mode indicator: stays on screen (the banner above comes and goes) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Mode indicator" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A small label that stays on screen while a mode group's app is in front and shows the active mode. Clicks pass through it."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="BtnPreviewIndicator" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Show preview" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Click="BtnPreviewIndicator_Click" ToolTip="Shows the indicator for a few seconds, in the position chosen below"/>
                            <CheckBox x:Name="ChkModeIndicator" Grid.Column="2" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Mode indicator"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Indicator position" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbIndicatorPosition" Grid.Column="1" Width="208">
                                <ComboBoxItem Content="Top center"/>
                                <ComboBoxItem Content="Top right"/>
                                <ComboBoxItem Content="Bottom right"/>
                                <ComboBoxItem Content="Bottom center"/>
                                <ComboBoxItem Content="Top left (default)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>

                <!-- SYSTEM -->
                <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <controls:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Launches quietly in the tray when you sign in." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Minimize to tray" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="The minimize button hides the window instead of using the taskbar." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Keep running when closed" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Closing the window keeps hotkeys active from the tray." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCloseToTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Administrator rights" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="TxtAdminHint" Style="{StaticResource Hint}"
                                           Text="Windows hides key presses made in apps that run as administrator from normal programs, so hotkeys do nothing there. Restart MacroMaster as administrator to use it in those apps."/>
                            </StackPanel>
                            <Button x:Name="BtnRestartAsAdmin" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Restart as administrator"
                                    VerticalAlignment="Center" Click="BtnRestartAsAdmin_Click"/>
                        </Grid>
                    </StackPanel>
                </controls:SmoothBorder>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" Click="CloseBtn_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" MinWidth="84" Click="SaveBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
