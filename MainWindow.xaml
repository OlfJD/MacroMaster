<Window x:Class="MacroMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacroMaster.UI.Controls"
        xmlns:models="clr-namespace:MacroMaster.Core.Models"
        Style="{StaticResource AppWindow}"
        Title="MacroMaster"
        Icon="Assets/app.ico"
        Width="1180" Height="780"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border x:Name="SidebarPane" Grid.Column="0" Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>   <!-- brand / caption -->
                    <RowDefinition Height="Auto"/> <!-- engine -->
                    <RowDefinition Height="*"/>    <!-- profiles -->
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="Auto"/> <!-- settings -->
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="{StaticResource LogoMark}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="MacroMaster" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Engine card -->
                <controls:SmoothBorder x:Name="EngineCard" Grid.Row="1" Margin="12,8,12,4" CornerRadius="{StaticResource RadiusLg}" Padding="14,12" BorderThickness="1"
                        Background="{StaticResource SuccessSubtleBrush}" BorderBrush="{StaticResource SuccessBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EngineTitle" Text="Engine running" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="EngineSubtitle" Text="Hotkeys are live" Style="{StaticResource Caption}" Margin="15,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="MasterEngineSwitchBox" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Engine"
                                  Checked="MasterEngineSwitch_Changed" Unchecked="MasterEngineSwitch_Changed" ToolTip="Pause or resume all hotkeys"/>
                    </Grid>
                </controls:SmoothBorder>

                <!-- Profiles -->
                <Grid Grid.Row="2" Margin="12,14,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,0,0,4">
                        <TextBlock Text="PROFILES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="NewProfileBtn_Click" ToolTip="New profile" AutomationProperties.Name="New profile">
                            <controls:AppIcon IconKey="plus" Size="16"/>
                        </Button>
                    </Grid>
                    <ListBox x:Name="ProfilesList" Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MacroProfile}">
                                <Grid Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename…" Click="RenameProfile_Click">
                                                <MenuItem.Icon><controls:AppIcon IconKey="pencil" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Export to a file…" Click="ExportProfile_Click" ToolTip="Save this profile and its macros as a file, to back it up or share it">
                                                <MenuItem.Icon><controls:AppIcon IconKey="upload" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete profile" Click="DeleteProfile_Click" Foreground="{StaticResource DangerBrush}">
                                                <MenuItem.Icon><controls:AppIcon IconKey="trash-2" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:AppIcon x:Name="ProfileIcon" IconKey="{Binding IconKey}" Size="16" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileName" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ProfileState" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0">
                                            <Run Text="{Binding Macros.Count, Mode=OneWay}"/><Run Text=" macros"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <CheckBox x:Name="ProfileSwitch" Grid.Column="2" Style="{StaticResource Switch}" Margin="8,0,0,0"
                                              IsChecked="{Binding IsOn, Mode=OneWay}" Checked="ProfileSwitch_Changed" Unchecked="ProfileSwitch_Changed"
                                              AutomationProperties.Name="{Binding Name, StringFormat='{}{0} on/off'}"
                                              ToolTip="Turn this profile's hotkeys on or off. Each macro keeps its own switch."/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ProfileSwitch}" Value="False">
                                        <Setter TargetName="ProfileName" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter TargetName="ProfileIcon" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Settings -->
                <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="12,8">
                    <Button Style="{StaticResource GhostButton}" Padding="10,0" Click="SettingsBtn_Click" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon IconKey="settings" Size="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= MAIN ======================= -->
        <Grid x:Name="MainPane" Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- caption (buttons are at the end of RootGrid) -->
                <RowDefinition Height="Auto"/> <!-- header -->
                <RowDefinition Height="Auto"/> <!-- toolbar -->
                <RowDefinition Height="*"/>    <!-- table -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="1" Margin="32,4,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Shown while the selected profile is switched off -->
                <controls:SmoothBorder x:Name="ProfileOffBanner" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Callout}" Margin="0,16,0,0" Padding="12,8,8,8"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:AppIcon IconKey="power" Size="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="This profile is off. Its macros won't run, but each macro keeps its own on/off setting."
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Height="28" Content="Turn on" Click="TurnProfileOn_Click"/>
                    </Grid>
                </controls:SmoothBorder>

                <StackPanel>
                    <TextBlock x:Name="TxtProfileTitle" Text="Profile" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtProfileSubtitle" Text="0 macros" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ImportAhkBtn_Click" AutomationProperties.Name="Import" ToolTip="Add an exported macro or profile file, or convert AutoHotkey (.ahk) scripts into macros. You can also drop files onto the window.">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon IconKey="download" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="NewMacroBtn_Click" AutomationProperties.Name="New macro">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon IconKey="plus" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="New macro" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar: search + filter -->
            <Grid Grid.Row="2" Margin="32,20,32,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource Input}" Padding="32,0,10,0" Tag="Search macros" TextChanged="TxtSearch_TextChanged"/>
                    <controls:AppIcon IconKey="search" Size="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <controls:SmoothBorder Grid.Column="2" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" Content="All" GroupName="Filter" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterEnabled" Style="{StaticResource Segment}" Content="Enabled" GroupName="Filter" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterDisabled" Style="{StaticResource Segment}" Content="Disabled" GroupName="Filter" Checked="Filter_Changed"/>
                    </StackPanel>
                </controls:SmoothBorder>
            </Grid>

            <!-- Macro table -->
            <controls:SmoothBorder Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="32,0,32,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers (widths mirror the row template) -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="164"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="MACRO" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TRIGGER" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="MODE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="STEPS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="MacrosListBox" Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource MacroRow}"
                             MouseDoubleClick="MacrosListBox_MouseDoubleClick" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewMouseLeftButtonDown="MacrosListBox_PreviewMouseLeftButtonDown" PreviewMouseMove="MacrosListBox_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="MacrosListBox_PreviewMouseLeftButtonUp" LostMouseCapture="MacrosListBox_LostMouseCapture" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <!-- Mode groups: macros sharing a hotkey, one switch key per mode. Ungrouped macros (Name "") render plain. -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <!-- A mode group is a framed block of its own: darker fill + outline, inset from the card edge.
                                                         Its rows are indented (see the RequiresArming trigger in the row template) so the bracket
                                                         keeps clear of the outline. Ungrouped macros (Name "") lose the frame in the trigger below. -->
                                                    <controls:SmoothBorder x:Name="Frame" Margin="6,8,6,8" ClipContent="True"
                                                                           Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                                                           BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
                                                        <Grid x:Name="FrameContent" Margin="0,0,0,-1">
                                                            <StackPanel>
                                                                <!-- Quiet label in the name column (one step in from the switches); the bracket does the linking.
                                                                     Fixed height: the bracket's top margin below depends on it. -->
                                                                <Border x:Name="Header" Height="40" Padding="20,0,9,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="52"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Group name set like a macro name (same column, same weight) with a count pill, like the rows' own tags -->
                                                                        <DockPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                            <Border x:Name="CountMany" DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,0,0,0">
                                                                                <TextBlock Style="{StaticResource TagText}">
                                                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" modes"/>
                                                                                </TextBlock>
                                                                            </Border>
                                                                            <Border x:Name="CountOne" DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,0,0,0" Visibility="Collapsed">
                                                                                <TextBlock Text="1 mode" Style="{StaticResource TagText}"/>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        </DockPanel>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="Switch with" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                            <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource HorizontalPanel}" Focusable="False">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type models:MacroDefinition}">
                                                                                        <controls:SmoothBorder x:Name="Chip" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                                CornerRadius="{StaticResource RadiusSm}" Padding="3,3,9,3" Margin="0,0,6,0">
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <Border Style="{StaticResource KeycapSm}" Margin="0,0,8,0"
                                                                                                        Visibility="{Binding ArmingKey, Converter={StaticResource EmptyToCollapsed}}">
                                                                                                    <TextBlock Text="{Binding ArmingKey}" Style="{StaticResource KeycapSmText}"/>
                                                                                                </Border>
                                                                                                <TextBlock x:Name="ChipText" Text="{Binding ModeShortName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </controls:SmoothBorder>
                                                                                        <DataTemplate.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCurrentlyArmed}" Value="True">
                                                                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
                                                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                                                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                                            </DataTrigger>
                                                                                        </DataTemplate.Triggers>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ItemsPresenter/>
                                                            </StackPanel>
                                                            <!-- Bracket linking the group's rows: runs from the first row's centre to the last row's centre
                                                                 (40 header + half of a 62 px row), with a tick pointing at each end's switch. -->
                                                            <!-- 8 px in from the frame's outline; its ticks end 3 px before the (indented) switches -->
                                                            <Border x:Name="Link" Width="9" HorizontalAlignment="Left" Margin="8,70,0,30" IsHitTestVisible="False"
                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,2,0,2" CornerRadius="4,0,0,4"/>
                                                        </Grid>
                                                    </controls:SmoothBorder>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="">
                                                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="Link" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="Frame" Property="Margin" Value="0"/>
                                                            <Setter TargetName="Frame" Property="BorderThickness" Value="0"/>
                                                            <Setter TargetName="Frame" Property="CornerRadius" Value="0"/>
                                                            <Setter TargetName="Frame" Property="Background" Value="Transparent"/>
                                                            <Setter TargetName="Frame" Property="ClipContent" Value="False"/>
                                                            <Setter TargetName="FrameContent" Property="Margin" Value="0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                            <Setter TargetName="CountMany" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="CountOne" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MacroDefinition}">
                                <Grid x:Name="Row" Height="62" Background="Transparent">
                                    <!-- "Move to <profile>" entries are added in MacroMenu_Opened -->
                                    <Grid.ContextMenu>
                                        <ContextMenu Opened="MacroMenu_Opened">
                                            <MenuItem Header="Edit" Click="MacroEdit_Click">
                                                <MenuItem.Icon><controls:AppIcon IconKey="pencil" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Duplicate" Click="MacroDuplicate_Click">
                                                <MenuItem.Icon><controls:AppIcon IconKey="copy" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Move up" Click="MacroMoveUp_Click">
                                                <MenuItem.Icon><controls:AppIcon IconKey="arrow-up" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Move down" Click="MacroMoveDown_Click">
                                                <MenuItem.Icon><controls:AppIcon IconKey="arrow-down" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Export…" Click="MacroExport_Click" ToolTip="Save this macro as a file to share or back up">
                                                <MenuItem.Icon><controls:AppIcon IconKey="upload" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="MacroDelete_Click" Foreground="{StaticResource DangerBrush}">
                                                <MenuItem.Icon><controls:AppIcon IconKey="trash-2" Size="16"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="164"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="EnableSwitch" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}"
                                              Checked="MacroEnable_Changed" Unchecked="MacroEnable_Changed" ToolTip="Enable or disable this macro"/>

                                    <!-- Name / description -->
                                    <StackPanel x:Name="InfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <!-- Left-aligned DockPanel: tags are docked right and keep their full width,
                                             the name (last child) takes what's left and ellipsizes instead of pushing tags out of view. -->
                                        <DockPanel HorizontalAlignment="Left">
                                            <!-- Mode group state: active mode, or which key switches to it -->
                                            <Border x:Name="ArmTag" DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="8,0,0,0"
                                                    Visibility="{Binding RequiresArming, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="ArmDot" Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="ArmText" Text="{Binding ArmingKey, StringFormat='Press {0} to use'}" Style="{StaticResource TagText}" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Running -->
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Background="{StaticResource SuccessSubtleBrush}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Running" Style="{StaticResource TagText}" Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                        </DockPanel>

                                        <!-- Category · app · description; the description fills the rest and ellipsizes -->
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding ProcessFilter, Converter={StaticResource IsGlobalProcess}}">
                                                <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                <controls:AppIcon IconKey="monitor" Size="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding ProcessFilter}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <DockPanel Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}">
                                                <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                            </DockPanel>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Trigger keycaps -->
                                    <ItemsControl x:Name="TriggerCaps" Grid.Column="2" VerticalAlignment="Center"
                                                  ItemsSource="{Binding Trigger.DisplayString, Converter={StaticResource TriggerKeys}}"
                                                  ItemTemplate="{StaticResource KeycapTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"/>

                                    <!-- Mode -->
                                    <!-- Mode: plain pill (an icon here read like a second "play" button) -->
                                    <Border x:Name="ModePanel" Grid.Column="3" Style="{StaticResource Tag}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Converter={StaticResource ModeLabel}}" Style="{StaticResource TagText}"/>
                                    </Border>

                                    <!-- Steps -->
                                    <TextBlock x:Name="StepsText" Grid.Column="4" Text="{Binding Actions.Count}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Row actions (revealed on hover) -->
                                    <StackPanel x:Name="RowActions" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                                        <Button Style="{StaticResource IconButton}" Click="MacroEdit_Click" ToolTip="Edit" AutomationProperties.Name="Edit" Margin="0,0,2,0">
                                            <controls:AppIcon IconKey="pencil" Size="16"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerIconButton}" Click="MacroDelete_Click" ToolTip="Delete" AutomationProperties.Name="Delete">
                                            <controls:AppIcon IconKey="trash-2" Size="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <!-- Fades in on hover; the exit animation has no To, so it settles on 1 while the row is selected -->
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowActions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowActions" Storyboard.TargetProperty="Opacity" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=EnableSwitch}" Value="False">
                                        <Setter TargetName="InfoPanel" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="TriggerCaps" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="ModePanel" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="StepsText" Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                    <!-- Inside a mode group's frame: indent the switch by 10 px (room for the bracket) and pull the
                                         right side back out by the frame's 7 px inset, so Trigger / Mode / Steps stay in their columns -->
                                    <DataTrigger Binding="{Binding RequiresArming}" Value="True">
                                        <Setter TargetName="Row" Property="Margin" Value="4,0,-7,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentlyArmed}" Value="True">
                                        <Setter TargetName="ArmTag" Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
                                        <Setter TargetName="ArmDot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ArmText" Property="Text" Value="Active mode"/>
                                        <Setter TargetName="ArmText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="340">
                        <Border Style="{StaticResource IconTileLg}" Margin="0,0,0,16">
                            <controls:AppIcon x:Name="EmptyIcon" IconKey="inbox" Size="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="No macros yet" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyBody" Text="Create one from scratch, record your inputs, or drop an AutoHotkey script anywhere on this window."
                                   Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16"/>
                        <Button x:Name="EmptyAction" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="NewMacroBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon IconKey="plus" Size="16" Margin="0,0,8,0"/>
                                <TextBlock Text="New macro" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:SmoothBorder>

            <!-- "Deleted … · Undo": floats over the bottom of the list for a few seconds after a delete -->
            <controls:SmoothBorder x:Name="UndoBar" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                                   Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                   CornerRadius="{StaticResource RadiusMd}" Padding="14,6,6,6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon IconKey="trash-2" Size="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UndoText" Text="Deleted" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Content="Undo" Click="Undo_Click"
                            AutomationProperties.Name="Undo" ToolTip="Put it back (Ctrl+Z)"/>
                    <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="UndoDismiss_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss undo">
                        <controls:AppIcon IconKey="x" Size="10"/>
                    </Button>
                </StackPanel>
            </controls:SmoothBorder>

            <!-- Drop overlay -->
            <Border x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="3" Margin="20,0,20,16" CornerRadius="{StaticResource RadiusLg}"
                    Background="{StaticResource ScrimBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource IconTileLg}" Background="{StaticResource AccentSubtleBrush}" Margin="0,0,0,16">
                        <controls:AppIcon IconKey="file-code" Size="20" Foreground="{StaticResource AccentTextBrush}"/>
                    </Border>
                    <TextBlock Text="Drop to import" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Macro files and AutoHotkey scripts become macros here; profile files are added as profiles" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= MACRO EDITOR PAGE =======================
             Hosts MacroEditorView in place of the sidebar + macro list while a macro is being
             created or edited (see OpenEditor). The status bar stays visible underneath. -->
        <Grid x:Name="EditorHost" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed"/>

        <!-- Caption buttons: last in row 0 so they stay on top of both pages -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Click="MinimizeBtn_Click" ToolTip="Minimize">
                <controls:AppIcon IconKey="minus" Size="10"/>
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="MaximizeBtn_Click">
                <controls:AppIcon x:Name="MaximizeIcon" IconKey="maximize" Size="10"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="CloseBtn_Click" ToolTip="Close">
                <controls:AppIcon IconKey="x" Size="10"/>
            </Button>
        </StackPanel>

        <!-- ======================= STATUS BAR ======================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusEngineText" Text="Engine running" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <!-- The engine on/off key (Settings): off = everything stops, on again with the same key -->
                    <StackPanel x:Name="StatusToggleHint" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="12" Background="{StaticResource BorderStrongBrush}" Margin="12,0"/>
                        <controls:AppIcon IconKey="power" Size="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusToggleLabel" Text="Stop everything" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Style="{StaticResource KeycapSm}">
                            <TextBlock x:Name="StatusToggleKey" Text="F12" Style="{StaticResource KeycapSmText}"/>
                        </Border>
                    </StackPanel>
                    <!-- Shown once an administrator app was in front (hotkeys can't reach those) -->
                    <StackPanel x:Name="AdminWarning" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Width="1" Height="12" Background="{StaticResource BorderStrongBrush}" Margin="12,0"/>
                        <controls:AppIcon IconKey="octagon-x" Size="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AdminWarningText" FontSize="12" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostButtonSm}" Content="Restart as administrator" Click="RestartAsAdmin_Click"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StatusCounts" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
